;; 􏵞: 0707，0706，0705，0704，0703。通常需要逆序，亦即(􏾛 􏵞)
;; Trend States
(名 (T1 L)
    (并 (> (dP (􏷜 L)) 0)
        (> (dP (􏷛 L)) 0)))
(名 (T2 L)
    (并 (< (dP (􏷜 L)) 0)
        (< (dP (􏷛 L)) 0)))
(名 (T3 L)
    (并 (> (dp (􏷜 L)) 0)
        (> (dp (􏷛 L)) 0)))
(名 (T4 L)
    (并 (< (dp (􏷜 L)) 0)
        (< (dp (􏷛 L)) 0)))
(名 (T5 L)
    (并 (<= (— (用 􏺗 (􏷑 P (􏾺 L 5)))
               (用 􏺘 (􏷑 P (􏾺 L 5))))
            1)
        (<= (— (用 􏺗 (􏷑 p (􏾺 L 5)))
               (用 􏺘 (􏷑 p (􏾺 L 5))))
            8)))
(名 (T6 L)
    (并 (T5 (􏾘 L 0))
        (> (p (􏷜 L))
           (用 􏺗 (􏷑 p (􏾝 L 1 6))))
        (> (dp (􏷜 L))
           0)))
(名 (T7 L)
    (并 (T5 (􏾘 L 0))
        (< (p (􏷜 L))
           (用 􏺘 (􏷑 p (􏾝 L 1 6))))
        (< (dp (􏷜 L))
           0)))
(名 (T8 L)
    (>= (巨 (􏹈 􏻛 (􏷑 dp (􏾺 L 3))))
        2)
    (>= (巨 (􏹈 􏻛 (􏷑 dv (􏾺 L 3))))
        2))
(名 (T9 L)
    (>= (巨 (􏹈 􏻚 (􏷑 dp (􏾺 L 3))))
        2)
    (>= (巨 (􏹈 􏻛 (􏷑 dv (􏾺 L 3))))
        2))
(名 (T10 L)
    (并 (>= (P (􏷜 L))
            6)
        (= (dP (􏷜 L))
           0)
        (< (dp (􏷜 L))
           0))
    )
(名 (T11 L)
    (并 (<= (P (􏷜 L))
            1)
        (= (dP (􏷜 L))
           0)
        (> (dp (􏷜 L))
           0))
    )

;; Price–Volume States
(名 (VP1 L)
    (并 (> (dP (􏷜 L)) 0)
        (> (dV (􏷜 L)) 0)))
(名 (VP2 L)
    (并 (> (dp (􏷜 L)) 0)
        (> (dv (􏷜 L)) 0)))
(名 (VP3 L)
    (并 (> (dp (􏷜 L)) 0)
        (< (dv (􏷜 L)) 0)))
(名 (VP4 L)
    (并 (> (dp (􏷜 L)) 0)
        (= (dv (􏷜 L)) 0)))
(名 (VP5 L)
    (并 (< (dP (􏷜 L)) 0)
        (< (dV (􏷜 L)) 0)))
(名 (VP6 L)
    (并 (< (dp (􏷜 L)) 0)
        (< (dv (􏷜 L)) 0)))
(名 (VP7 L)
    (并 (< (dp (􏷜 L)) 0)
        (< (dv (􏷜 L)) 0)))
(名 (VP8 L)
    (并 (<= (P (􏷜 L)) 1)
        (< (dp (􏷜 L)) 0)
        (> (dv (􏷜 L)) 0)))
(名 (VP9 L)
    (并 (= (dp (􏷜 L)) 0)
        (> (dv (􏷜 L)) 0)))
(名 (VP10 L)
    (并 (= (dp (􏷜 L)) 0)
        (< (dv (􏷜 L)) 0)))
(名 (VP11 L)
    (并 (> (dp (􏷜 L)) 0)
        (< (dv (􏷜 L)) 0)))
(名 (VP12 L)
    (并 (< (dp (􏷜 L)) 0)
        (> (dv (􏷜 L)) 0)))

;; Position and Extreme States
(名 (E1 L)
    (= (P (􏷜 L)) 7))
(名 (E2 L)
    (= (P (􏷜 L)) 0))
(名 (E3 L)
    (>= (P (􏷜 L)) 6))
(名 (E4 L)
    (<= (P (􏷜 L)) 1))
(名 (E5 L)
    (= (p (􏷜 L)) 63))
(名 (E6 L)
    (= (p (􏷜 L)) 0))
(名 (E7 L)
    (>= (V (􏷜 L)) 6))
(名 (E8 L)
    (<= (V (􏷜 L)) 1))
(名 (E9 L)
    (= (V (􏷜 L)) 7))
(名 (E10 L)
    (= (V (􏷜 L)) 0))

;; Local High / Low States
(名 (E11 L)
    (> (p (􏷜 L))
       (用 􏺗 (􏷑 p (􏾺 (􏾘 L 0) 19)))))
(名 (E12 L)
    (< (p (􏷜 L))
       (用 􏺘 (􏷑 p (􏾺 (􏾘 L 0) 19)))))
(名 (E13 L)
    (> (p (􏷜 L))
       (用 􏺗 (􏷑 p (􏾺 (􏾘 L 0) 4)))))
(名 (E14 L)
    (< (p (􏷜 L))
       (用 􏺘 (􏷑 p (􏾺 (􏾘 L 0) 4)))))

;; Short-Term Divergence
(名 (D1 L)
    (并 (>= (P (􏷜 L))  6)
        (>  (dp (􏷜 L)) 0)
        (>  (dv (􏷜 L)) 0)))
(名 (D2 L)
    (并 (<= (P (􏷜 L)) 1)
        (< (dp (􏷜 L)) 0)
        (< (dv (􏷜 L)) 0)))

;; Structural Divergence
(名 (D3 L)
    (并 (> (p (􏷛 p峰L))
           (p (􏷜 p峰L)))
        (< (v (􏷛 v峰L))
           (v (􏷜 v峰L)))))
(名 (D4 L)
    (并 (< (p (􏷛 p谷L))
           (p (􏷜 p谷L)))
        (> (v (􏷛 v谷L))
           (v (􏷜 v谷L)))))


;; Compression States
(名 (C1 L)
    (并 (<= (- (用 􏺗 (􏷑 P (􏾺 L 5)))
               (用 􏺘 (􏷑 P (􏾺 L 5))))
            1)
        (<= (- (用 􏺗 (􏷑 p (􏾺 L 5)))
               (用 􏺘 (􏷑 p (􏾺 L 5))))
            8)
        (<= (用 􏺗 (􏷑 V (􏾺 L 5)))
            2)))
(名 (C2 L)
    (并 (>= (􏹈 (λ (e) (>= e 6))
                (􏷑 P (􏾺 L 5)))
            4)
        (<= (- (用 􏺗 (􏷑 p (􏾺 L 5)))
               (用 􏺘 (􏷑 p (􏾺 L 5))))
            8)))
(名 (C3 L)
    (并 (>= (􏹈 (λ (e) (<= e 1))
                (􏷑 P (􏾺 L 5)))
            4)
        (<= (- (用 􏺗 (􏷑 p (􏾺 L 5)))
               (用 􏺘 (􏷑 p (􏾺 L 5))))
            8)))
(名 (C4 L)
    (并 (>= (􏹈 (λ (e) (> e 0))
                (􏷑 dv (􏾺 L 3)))
            2)
        (<= (- (用 􏺗 (􏷑 p (􏾺 L 3)))
               (用 􏺘 (􏷑 p (􏾺 L 3))))
            8)))
(名 (C5 L)
    (并 (>= (􏹈 (λ (e) (< e 0))
                (􏷑 dv (􏾺 L 3)))
            2)
        (<= (- (用 􏺗 (􏷑 p (􏾺 L 3)))
               (用 􏺘 (􏷑 p (􏾺 L 3))))
            8)))
(名 (C6 L)
    (并 (>= (P (􏷜 L)) 6)
        (>= (􏹈 (λ (e) (< e 0))
                (􏷑 dv (􏾺 L 3)))
            2)
     (<= (dP (􏷜 L)) 0)
     ))
(名 (C7 L)
    (并 (<= (P (􏷜 L)) 1)
        (>= (􏹈 (λ (e) (> e 0))
                (􏷑 dv (􏾺 L 3)))
            2)
        (<= (- (用 􏺗 (􏷑 p (􏾺 L 3)))
               (用 􏺘 (􏷑 p (􏾺 L 3))))
            8)
        ))

;; Breakout States
(名 (BO1 L)
    (并 (> (p (􏷜 L))
           (用 􏺗 (p (􏾝 1 5))))
        (> (dp (􏷜 L))
           0)))
(名 (BO2 L)
    (并 (BO1 L)
        (> (dv (􏷜 L))
           0)))
(名 (BO3 L)
    (并 (BO2 L)
        (> (V (􏷜 L))
           (/ (􏷎 + 0 (V (􏾝 1 5))) 4))))
(名 (BO4 L)
    (并 (> (p (􏷜 L))
           (用 􏺘 (p (􏾝 1 5))))
        (< (dp (􏷜 L))
           0)))
(名 (BO5 L)
    (并 (BO4 L)
        (< (dp (􏷜 L))
           0)))
(名 (BO6 L)
    (并 (BO4 L)
        (> (dp (􏷜 L))
           0)
        (> (V (􏷜 L))
           (/ (􏷎 + 0 (V (􏾝 1 5))) 4))))


;; Buy Signals
(名 (B1 L)
    (并 (T5 L)
        (BO2 L)))
(名 (B2 L)
    (并 (T5 L)
        (BO3 L)))
(名 (B3 L)
    (并 (>= (􏹈 􏻛 (􏷑 dp (􏾺 L 3)))
           2)
        (< (dp (􏷜 L))
           0)))
(名 (B4 L)
    (并 (D4 L)
        (> (dp (􏷜 L)) 0)))
(名 (B5 L)
    (并 (C7 L)
        (<= (P (􏷜 L)) 1)
        (> (dp (􏷜 L)) 0)))
(名 (B6 L)
    (并 (<= (P (􏷜 L)) 1)
        (> (dp (􏷜 L)) 0)
        (> (dv (􏷜 L)) 0)))
(名 (B7 L)
    (并 (E11 L)
        (> (dp (􏷜 L)) 0)
        (>= (dv (􏷜 L)) 0)))

;; Sell Signals
(名 (S1 L)
    (并 (D1 L)
        (D1 (􏾘 L 0))))
(名 (S2 L)
    (并 (D3 L)
        (< (dp (􏷜 L)) 0)))
(名 (S3 L)
    (并 (>= (􏹈 􏻛 (􏷑 dp (􏾺 L 3)))
            2)
        (< (dp (􏷜 L))
           0)
        (< (p (􏷜 L))
           (􏺘 (􏷑 p (􏾝 L 1 4))))))
(名 (S4 L) (BO5 L))
(名 (S5 L) (BO6 L))
(名 (S6 L) (C6 L))
(名 (S7 L)
    (并 (>= (P (􏷜 L)) 6)
        (>= (V (􏷜 L)) 6)
        (<= (dp (􏷜 L)) 0)))
(名 (S8 L)
    (名 (BO? L)
        (戈 (BO1 L) (BO2 L) (BO3 L)))
    (名 Ps
        (􏷑 p (􏷑 􏷜 (􏹈 BO? (􏿴 (􏾝 L 1) (􏾝 L 2))))))
    (并 (𥦯? Ps)
        (<= (p (􏷜 L)) (用 􏺗 Ps))
        (< (dp (􏷜 L)) 0)))
